APP_ENV=production
PAYPAL_ENV=sandbox
PORT=8080
DATA_DIR=/data
DATABASE_URL=                      # empty => sqlite+aiosqlite:////data/app.db ; or postgresql+asyncpg://...
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=               # python -m app.tools.hash_password
ALLOWED_HOSTS=                     # e.g. day0-shield.onrender.com
TRUSTED_PROXY_IPS=                 # proxy CIDRs/IPs; "*" only behind a trusted platform proxy
FORCE_HTTPS=true
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com   # added: bootcheck verifies it is exactly this
PAYPAL_MCP_URL=                    # optional; must start with https://mcp.sandbox.paypal.com
PAYPAL_TOOL_TRANSPORT=toolkit
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
AG_STUDIO_LICENSE_KEY=
BRYNTUM_LICENSE_KEY=
MAX_REFUND_OFFER_USD=
MAX_ACTIONS_PER_MINUTE=
MAX_DAILY_WRITES=
MAX_LLM_CALLS_PER_HOUR=
EXECUTION_MODE=queue
SEED_ON_BOOT=false
DEBUG=false                        # added: must be false in production
